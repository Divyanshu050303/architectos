# Copy to .env for local development. Never commit real secrets.

# --- Database -----------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). Matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://architectos:architectos@127.0.0.1:5434/architectos
# Database the integration tests may create and drop scratch databases on.
TEST_DATABASE_URL=postgresql+asyncpg://architectos:architectos@127.0.0.1:5434/postgres
# Log every SQL statement (development only; statements can contain personal data).
DATABASE_ECHO=false

# --- HTTP ---------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). The web app in development:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Passwords ----------------------------------------------------------------
# Minimum length (8-128). 12 follows OWASP ASVS; the web app's hint must match.
PASSWORD_MIN_LENGTH=12
