# Copy to .env for local development. Never commit real secrets.

# development | test | production. Production refuses plain-text SMTP and an http FRONTEND_URL.
ENVIRONMENT=development

# --- Database -----------------------------------------------------------------
# Async SQLAlchemy URL (asyncpg driver). Matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://architectos:architectos@127.0.0.1:5434/architectos
# Database the integration tests may create and drop scratch databases on.
TEST_DATABASE_URL=postgresql+asyncpg://architectos:architectos@127.0.0.1:5434/postgres
# Log every SQL statement (development only; statements can contain personal data).
DATABASE_ECHO=false

# --- HTTP ---------------------------------------------------------------------
# Browser origins allowed to call the API (comma-separated). The web app in development:
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Profiles -----------------------------------------------------------------
# Hosts avatar URLs may use (comma-separated). Empty allows any https host; set it in production.
AVATAR_URL_ALLOWED_HOSTS=

# --- Passwords ----------------------------------------------------------------
# Minimum length (8-128). 12 follows OWASP ASVS; the web app's hint must match.
PASSWORD_MIN_LENGTH=12

# --- Email --------------------------------------------------------------------
# Web app base URL; every link in an email points here.
FRONTEND_URL=http://localhost:3000
EMAIL_FROM=ArchitectOS <no-reply@localhost>
# Mailpit from docker-compose (web UI http://127.0.0.1:8025). Production: your provider's relay.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
# none | starttls | tls
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
# ISO 8601 durations (PT24H, PT60S) or [HH:MM:]SS.
EMAIL_VERIFICATION_TTL=PT24H
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT60S
# Reset links: lifetime and minimum gap between two reset emails to one account.
PASSWORD_RESET_TTL=PT30M
PASSWORD_RESET_COOLDOWN=PT60S
# How long an organization invitation link stays valid.
INVITATION_TTL=P7D

# --- Sessions -----------------------------------------------------------------
# REQUIRED. Signs access tokens; at least 32 characters. Generate one per environment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_TTL=PT15M
# Absolute session lifetime from sign-in.
REFRESH_TOKEN_TTL=P30D
# Window in which a just-rotated refresh token is treated as a concurrent refresh, not theft.
REFRESH_REUSE_GRACE=PT10S
# Browsers accept Secure cookies from http://localhost, so this stays true in development.
COOKIE_SECURE=true
# lax | strict | none (none only if the web app and API are on different sites; needs COOKIE_SECURE).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
