# Public configuration only. These values are inlined into the browser bundle at build time.
# Never put secrets here (no NEXT_PUBLIC_*_API_KEY): LLM keys and cloud credentials belong to the backend.

NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_ENV=development

# Serve responses from the in-browser mock transport (api/mock) instead of the backend.
# Every screen shows a "Mock data" badge while this is on.
NEXT_PUBLIC_API_MOCKS=true
